# Orchestrator
OPENAI_API_KEY=
OPENAI_MODEL=            # set later by the team; required unless MOCK_LLM=1
# Huawei OMNI (Qwen3.5-Omni via OpenAI-compatible endpoint; base URL arrives with the sponsor key)
OMNI_API_KEY=
OMNI_BASE_URL=
OMNI_MODEL=qwen3.5-omni-flash
OMNI_FORCE_STREAM=auto   # auto|true|false (some Qwen-Omni endpoints require stream=True)
# Modes
MOCK_LLM=auto            # auto = on when OPENAI_API_KEY empty
MOCK_OMNI=auto           # auto = on when OMNI_API_KEY empty
DEMO_REPLAY=0
MAX_AGENT_STEPS=30
# Optional: only for scripts/fetch_firms.py (re-download FIRMS in 5-day chunks)
FIRMS_MAP_KEY=
