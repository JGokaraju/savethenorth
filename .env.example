OPENAI_API_KEY=
# set later by the team; required unless MOCK_LLM=1
OPENAI_MODEL=
# Huawei OMNI (Qwen3.5-Omni via OpenAI-compatible endpoint; base URL arrives with the sponsor key)
OMNI_API_KEY=
OMNI_BASE_URL=
